# Copy to `.env` and fill in the values from your Turso database:
#
#   turso db show <db-name> --url
#   turso db tokens create <db-name>
TURSO_URL=libsql://your-db-your-org.turso.io
TURSO_TOKEN=your-token

# The account the profile form is sent from. The letter goes to
# utsbishkek@gmail.com, set in `src/mail.rs`.
#
# Gmail needs an app password here, not the account password:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-password
